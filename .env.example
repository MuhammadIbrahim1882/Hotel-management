PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_management
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_long_random_string
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM="Hotel Serenade <noreply@hotelserenade.com>"
PAYMENT_SECRET_KEY=replace_with_stripe_or_gateway_key
BCRYPT_ROUNDS=12
MAX_UPLOAD_MB=5

# Optional PostgreSQL container config
POSTGRES_DB=hotel_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
